/*
 * External Frontend Component Interface
 *
 * Receives raw frames from ExtNicDrv and converts them to MsgHeader + payload format
 * First processing stage that creates standardized message format
 *
 * SPDX-License-Identifier: BSD-2-Clause
 */

import <std_connector.camkes>;
import <SerialServer/SerialServer.camkes>;

component ExtFrontend {
    control;

    /* Input from ExtNicDrv */
    dataport Buf in_dp;
    consumes Notification in_ntfy;

    /* Output to ParserNorm */
    dataport Buf out_dp;
    emits Notification out_ntfy;

    /* Serial output for debugging */
    uses SerialServer serial_getchar;
}