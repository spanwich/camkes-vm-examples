/*
 * Parser/Normalizer Component Interface
 *
 * Validates incoming messages using bounds checking and EverParse hooks
 * Drops invalid messages and forwards valid ones unchanged (phase 1)
 *
 * SPDX-License-Identifier: BSD-2-Clause
 */

import <std_connector.camkes>;
import <SerialServer/SerialServer.camkes>;

component ParserNorm {
    control;

    /* Input from ExtFrontend */
    dataport Buf in_dp;
    consumes Notification in_ntfy;

    /* Output to PolicyEmit */
    dataport Buf out_dp;
    emits Notification out_ntfy;

    /* Serial output for debugging */
    uses SerialServer serial_getchar;
}