/*
 * Copyright 2024, PhD Research Project
 * Network Driver Component - VirtIO-Net MMIO Driver (V3)
 *
 * Real VirtIO-Net device driver implementation
 * - MMIO register access at 0xa003000
 * - RX virtqueue management
 * - Interrupt-driven packet reception (IRQ 79)
 * - Ethernet/IP/TCP frame parsing
 * - Protocol detection (Modbus TCP, DNP3, EtherNet/IP)
 *
 * SPDX-License-Identifier: BSD-2-Clause
 */

import <std_connector.camkes>;

component NetworkDriverDrv {
    control;

    /* Output to ExtFrontend (same interface as original ExtNicDrv) */
    dataport Buf(65536) out_dp;
    emits Notification out_ntfy;

    /* VirtIO-Net MMIO register access (map 8KB to cover multiple slots) */
    dataport Buf(8192) virtio_mmio;

    /* VirtIO-Net interrupt handling (IRQ 79) */
    consumes Interrupt eth_irq;
}

/* Hardware component for VirtIO device (MMIO + interrupt) */
component VirtIOHW {
    hardware;
    dataport Buf(8192) mmio;
    emits Interrupt eth_irq;
}