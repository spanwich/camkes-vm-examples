/*
 * Policy and Emitter Component Interface
 *
 * Applies ICS security policies to validated messages
 * Phase 1: allow-all policy with hooks for future policy implementation
 *
 * SPDX-License-Identifier: BSD-2-Clause
 */

import <std_connector.camkes>;
import <SerialServer/SerialServer.camkes>;

component PolicyEmit {
    control;

    /* Input from ParserNorm */
    dataport Buf in_dp;
    consumes Notification in_ntfy;

    /* Output to IntNicDrv */
    dataport Buf out_dp;
    emits Notification out_ntfy;

    /* Serial output for debugging */
    uses SerialServer serial_getchar;
}