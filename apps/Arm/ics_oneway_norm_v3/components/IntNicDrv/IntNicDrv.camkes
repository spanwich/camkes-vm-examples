/*
 * Internal NIC Driver Component Interface
 *
 * Final destination for messages in the one-way pipeline
 * Receives approved messages and provides statistics and monitoring
 *
 * SPDX-License-Identifier: BSD-2-Clause
 */

import <std_connector.camkes>;
import <TimeServer/TimeServer.camkes>;
import <SerialServer/SerialServer.camkes>;

component IntNicDrv {
    control;

    /* Input from PolicyEmit (final stage) */
    dataport Buf in_dp;
    consumes Notification in_ntfy;

    /* Timer for periodic statistics reporting */
    uses Timer timer;
    consumes Notification timer;

    /* Serial output for debugging */
    uses SerialServer serial_getchar;
}