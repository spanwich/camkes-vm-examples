#include <plat/smc.h>
#include <configurations/vm.h>
#include "vm_file_sizes.h"

#define VM_INITRD_MAX_SIZE 0x1900000 //25 MB
#define VM_RAM_BASE 0x50000000
#define VM_RAM_SIZE 0x30000000
#define VM_RAM_PAGE_SIZE_BITS 21
#define VM_ENTRY_ADDR 0x50080000
#define VM_RAM_OFFSET 0
#define VM_DTB_ADDR 0x52000000
#define VM_INITRD_ADDR 0x53000000

assembly {
    composition {}
    configuration {

        vm1.vm_address_config = {
            "ram_base" : VAR_STRINGIZE(VM_RAM_BASE),
            "ram_paddr_base" : VAR_STRINGIZE(VM_RAM_BASE),
            "ram_page_size_bits" : VAR_STRINGIZE(VM_RAM_PAGE_SIZE_BITS),
            "ram_size" : VAR_STRINGIZE(VM_RAM_SIZE),
            "dtb_addr" : VAR_STRINGIZE(VM_DTB_ADDR),
            "initrd_addr" : VAR_STRINGIZE(VM_INITRD_ADDR),
            "kernel_entry_addr" : VAR_STRINGIZE(VM_ENTRY_ADDR),
        };
        vm1_1.vm_address_config <- vm1.vm_address_config;
        vm1_2.vm_address_config <- vm1.vm_address_config;
        vm1_3.vm_address_config <- vm1.vm_address_config;


        vm1.memdev_hardware_cached = true;
        vm1_1.memdev_hardware_cached = true;
        vm1_2.memdev_hardware_cached = true;
        vm1_3.memdev_hardware_cached = true;
        vm_memdev1.paddr = VM_RAM_BASE;
        vm_memdev1.size = VM_RAM_SIZE;

        vm1.vm_image_config = {
            "kernel_name" : "linux_kernel",
            "kernel_image_size" : VAR_STRINGIZE(FILE_linux_kernel_SIZE),
            "initrd_size" : VAR_STRINGIZE(FILE_linux_initrd_SIZE),
            "initrd_name" : "linux_initrd",
            "dtb_base_name" : "linux_dtb",
            "kernel_bootcmdline" : "console=ttyPS0,115200 root=/dev/ram rw earlycon clk_ignore_unused",
            "kernel_stdout" : "serial0:115200n8",
            "generate_dtb" : true,
            "provide_dtb" : true,
            "map_one_to_one" : false,
            "provide_initrd": true,
            "clean_cache" : false,
        };
        vm1_1.vm_image_config = {
            "dtb_base_name" : "linux_dtb",
            "generate_dtb" : false,
            "provide_dtb" : false,
        };
        vm1_2.vm_image_config <- vm1_1.vm_image_config;
        vm1_3.vm_image_config <- vm1_1.vm_image_config;

        vm1.mmios = ["0xf9060000:0x1000:12"]; // Interrupt Controller Virtual CPU interface (Virtual Machine view)
        vm1_1.mmios <- vm1.mmios;
        vm1_2.mmios <- vm1.mmios;
        vm1_3.mmios <- vm1.mmios;
        vm1.plat_keep_devices = [
            "/pss_ref_clk",
            "/gt_crx_ref_clk",
            "/pss_alt_ref_clk",
            "/aux_ref_clk",
            "/video_clk",
            "/pmu",
            "/psci",
            "/timer",
            "/aliases",
            "/amba/serial@ff000000",
            "/cpus/cpu@0",
            "/cpus/cpu@1",
            "/cpus/cpu@2",
            "/cpus/cpu@3"
        ];
        vm1_1.plat_keep_devices <- vm1.plat_keep_devices;
        vm1_2.plat_keep_devices <- vm1.plat_keep_devices;
        vm1_3.plat_keep_devices <- vm1.plat_keep_devices;

        vm1.plat_keep_devices_and_subtree = [
            "/firmware",
            "/amba/pinctrl@ff180000"
        ];

        vm1_1.plat_keep_devices_and_subtree <- vm1.plat_keep_devices_and_subtree;
        vm1_2.plat_keep_devices_and_subtree <- vm1.plat_keep_devices_and_subtree;
        vm1_3.plat_keep_devices_and_subtree <- vm1.plat_keep_devices_and_subtree;

        vm1.allow_smc = true;
        vm1_1.allow_smc = true;
        vm1_2.allow_smc = true;
        vm1_3.allow_smc = true;
        vm1.allowed_smc_functions = [
            SMC_PM_GET_API_VERSION,
            SMC_PM_REQUEST_NODE,
            SMC_PM_SET_REQUIREMENT,
            SMC_PM_INIT_FINALIZE,
            SMC_PM_PINCTRL_REQUEST,
            SMC_PM_PINCTRL_RELEASE,
            SMC_PM_PINCTRL_SET_FUNCTION,
            SMC_PM_PINCTRL_CONFIG_PARAM_SET,
            SMC_PM_IOCTL,
            SMC_PM_QUERY_DATA,
            SMC_PM_CLOCK_ENABLE,
            SMC_PM_CLOCK_GETSTATE,
            SMC_PM_CLOCK_GETDIVIDER,
            SMC_PM_CLOCK_GETPARENT,
            SMC_PM_GET_TRUSTZONE_VERSION,

        ];
        vm1_1.allowed_smc_functions <- vm1.allowed_smc_functions;
        vm1_2.allowed_smc_functions <- vm1.allowed_smc_functions;
        vm1_3.allowed_smc_functions <- vm1.allowed_smc_functions;
    }
}
